APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
TEST_MODE=false
MOCK_LLM=false
MOCK_AMAP=true
MOCK_SEARCH=false

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=1

DATABASE_URL=postgresql+asyncpg://YOUR_LOCAL_USERNAME@127.0.0.1:5432/deeptravel

# 推荐：本地 Ollama + Qwen3-Embedding-0.6B。
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=16
EMBEDDING_KEEP_ALIVE=10m
EMBEDDING_QUERY_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
RAG_MIN_RELIABLE_CHUNKS=2
WEB_FETCH_MAX_PAGES=3
WEB_RERANK_TOP_K=5
WEB_FETCH_RENDERER=auto
WEB_FETCH_TIMEOUT_SECONDS=12
WEB_FETCH_MIN_CONTENT_CHARS=400
PLAYWRIGHT_TIMEOUT_SECONDS=15
PLAYWRIGHT_MAX_CONCURRENCY=2

# 四个专项 Agent 的全局执行边界。
AGENT_MAX_TOOL_CALLS=4
AGENT_TIMEOUT_SECONDS=120
AGENT_GRAPH_RECURSION_LIMIT=12
SHORT_MEMORY_MESSAGES=12

# 高德远程 MCP，传输协议为标准 Streamable HTTP。
AMAP_PROVIDER=mcp
AMAP_MCP_ENDPOINT=https://mcp.amap.com/mcp
AMAP_MCP_API_KEY=
AMAP_MCP_TIMEOUT_SECONDS=30
# Python mcp-server-12306 Streamable HTTP 服务（建议独立监听 8200，避免占用后端 8000）
RAILWAY_MCP_ENDPOINT=http://127.0.0.1:8200/mcp
RAILWAY_MCP_TIMEOUT_SECONDS=30
RAILWAY_RESULT_LIMIT=9
SEARCH_MCP_ENDPOINT=http://127.0.0.1:8100/mcp
SEARCH_MCP_INTERNAL_API_KEY=
SEARCH_PROVIDER=duckduckgo
DUCKDUCKGO_REGION=cn-zh
DUCKDUCKGO_SAFESEARCH=moderate
DUCKDUCKGO_TIMEOUT_SECONDS=10
TAVILY_API_KEY=

# 首次启动时自动创建唯一管理员，请使用强密码。普通用户只能通过页面注册。
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
AUTH_TOKEN_TTL_DAYS=7

# 微信小程序登录（在微信公众平台获取；留空时小程序会提示先配置）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_LOGIN_TIMEOUT_SECONDS=10
